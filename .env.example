# ---------------------------------------------------------------
# Supabase (Project Settings → API Keys)
# Local development: values printed by `npx supabase start`
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (sb_publishable_…) — or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# "Secret" key (sb_secret_…) — or the legacy "service_role" key. SERVER ONLY, never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the site (used in links sent to customers)
NEXT_PUBLIC_SITE_URL=http://localhost:3800

# Random string used to anonymise visitor IPs (rate limiting)
IP_HASH_SALT=change-me-to-a-long-random-string

# ---------------------------------------------------------------
# Optional — e-mails (https://resend.com)
# Sends devis/factures by e-mail with the PDF attached, and notifies
# you of new requests. Without it, the dashboard opens your own mail app.
# ---------------------------------------------------------------
RESEND_API_KEY=
# Must use a domain verified in Resend, e.g. "Repareliya <devis@your-domain.com>"
EMAIL_FROM=
# Where new-request notifications go (defaults to the e-mail set in Paramètres)
ADMIN_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------
# Optional — anti-spam Cloudflare Turnstile (dash.cloudflare.com → Turnstile)
# Adds a bot check to the devis / contact / accessoire forms and to the
# review form. Enabled only when both keys are set. Add your domain (and
# localhost for development) to the widget's hostnames.
# Test keys that always pass: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
# ---------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------
# Optional — Google reviews (Places API "New")
# Shows your Google rating + latest Google reviews. Also set the
# Place ID in Tableau de bord → Paramètres.
# ---------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
